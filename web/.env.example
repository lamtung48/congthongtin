# Copy this file to `.env` and fill in real values for your machine/environment.
# Never commit `.env` — only this template is tracked (see `.gitignore`'s
# `!.env.example` negation of the blanket `.env*` ignore rule).
# See docs/ENVIRONMENT.md for the full explanation of each variable.

# Primary connection Prisma Client uses at runtime (via `@prisma/adapter-pg`).
# In production this is typically a pooled connection (PgBouncer, RDS Proxy,
# Neon/Supabase pooler, etc.) — see DIRECT_DATABASE_URL below for why a
# second, unpooled URL is sometimes needed alongside it.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hsv_portal_dev?schema=public"

# A second, empty database only `prisma migrate dev` uses locally to detect
# schema drift by replaying migrations against a throwaway copy. Never
# pointed at production; not read by the running app at all.
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hsv_portal_shadow?schema=public"

# Optional. Only set this if DATABASE_URL points at a connection pooler that
# can't run schema migrations (common with PgBouncer/serverless Postgres
# providers) — `prisma migrate deploy` then uses this direct, unpooled URL
# instead. Leave empty for a plain local/self-hosted Postgres like this
# project's dev setup, where DATABASE_URL is already a direct connection.
DIRECT_DATABASE_URL=""
