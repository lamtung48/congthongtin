# Copy this file to `.env` and fill in real values for your machine/environment.
# Never commit `.env` — only this template is tracked (see `.gitignore`'s
# `!.env.example` negation of the blanket `.env*` ignore rule).
# See docs/ENVIRONMENT.md for the full explanation of each variable.

# Primary connection Prisma Client uses at runtime (via `@prisma/adapter-pg`).
# In production this is typically a pooled connection (PgBouncer, RDS Proxy,
# Neon/Supabase pooler, etc.) — see DIRECT_DATABASE_URL below for why a
# second, unpooled URL is sometimes needed alongside it.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hsv_portal_dev?schema=public"

# A second, empty database only `prisma migrate dev` uses locally to detect
# schema drift by replaying migrations against a throwaway copy. Never
# pointed at production; not read by the running app at all.
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hsv_portal_shadow?schema=public"

# Optional. Only set this if DATABASE_URL points at a connection pooler that
# can't run schema migrations (common with PgBouncer/serverless Postgres
# providers) — `prisma migrate deploy` then uses this direct, unpooled URL
# instead. Leave empty for a plain local/self-hosted Postgres like this
# project's dev setup, where DATABASE_URL is already a direct connection.
DIRECT_DATABASE_URL=""

# Google Drive media storage (see docs/GOOGLE_DRIVE_MEDIA.md). Both
# credential variables are required — without them `src/server/integrations/
# googleDrive.ts` treats Drive as "not configured" and every upload/delete
# fails with a clear, caught error rather than a crash (brief section 10).
# Never commit real values for these — a leaked service-account key grants
# whatever Drive access the account was given.

# Service account email, from the JSON key downloaded when the service
# account was created in Google Cloud Console (IAM & Admin > Service
# Accounts > Keys), e.g. "hsv-media@my-project.iam.gserviceaccount.com".
GOOGLE_DRIVE_CLIENT_EMAIL=""

# The same JSON key's "private_key" field, pasted as-is (its embedded
# newlines become literal `\n` sequences here, which googleDrive.ts
# unescapes at startup — this is the standard workaround for storing a
# multi-line PEM key in a single-line env var). Keep the surrounding quotes.
GOOGLE_DRIVE_PRIVATE_KEY=""

# Optional. A plain "My Drive" folder id to upload into (the id in that
# folder's URL). Works with a bare service account, no Google Workspace
# required. Ignored when GOOGLE_DRIVE_SHARED_DRIVE_ID is also set — a Shared
# Drive is preferred whenever a Workspace makes one available (brief section
# 2). Leave both empty to upload to the service account's own Drive root.
GOOGLE_DRIVE_FOLDER_ID=""

# Optional. A Google Shared Drive id (Workspace only) — takes priority over
# GOOGLE_DRIVE_FOLDER_ID when set. The service account must already be a
# member of this Shared Drive with at least Content Manager access.
GOOGLE_DRIVE_SHARED_DRIVE_ID=""

# YouTube video integration (see docs/YOUTUBE_INTEGRATION.md). Videos are
# never stored on this VPS — they're uploaded to/played from a real YouTube
# channel via the YouTube Data API. All four OAuth variables below are
# required together — without them `src/server/integrations/youtube.ts`
# treats YouTube as "not configured" and every upload/connect action fails
# with a clear, caught error rather than a crash (same discipline as Google
# Drive above). Unlike Drive, this uses a real OAuth2 authorization-code
# flow, not a service account — there is no service-account equivalent for
# "upload video to someone's channel"; an Admin must complete Google's
# consent screen once from `/admin/media/videos` after these are set.

# OAuth 2.0 Client ID/Secret from Google Cloud Console (APIs & Services >
# Credentials > OAuth client ID > Web application), with the YouTube Data
# API v3 enabled on the same project.
YOUTUBE_OAUTH_CLIENT_ID=""
YOUTUBE_OAUTH_CLIENT_SECRET=""

# Must exactly match one of the "Authorized redirect URIs" configured on
# that OAuth client, and must point at this app's own callback route, e.g.
# "http://localhost:3000/api/admin/youtube/oauth/callback" in development or
# "https://<your-domain>/api/admin/youtube/oauth/callback" in production.
YOUTUBE_OAUTH_REDIRECT_URI=""

# Any secret string (a long random value — e.g. `openssl rand -hex 32`) used
# to derive the AES-256-GCM key that encrypts the connected channel's OAuth
# refresh token at rest in the database. Changing this after a channel is
# connected makes the stored token undecryptable — the Admin will need to
# reconnect. Never commit a real value; losing it has the same effect as
# rotating it.
YOUTUBE_TOKEN_ENCRYPTION_KEY=""

# Optional, default "false". Brief section 1/3: Contributor may upload
# videos directly (instead of only linking/browsing existing ones) only when
# this is "true" — a deployment-wide policy switch, not a per-user setting,
# so changing it requires a redeploy. Contributor uploads are always forced
# to "unlisted" visibility regardless of this setting (enforced in
# `youtubeService.ts`, not just hidden in the UI).
YOUTUBE_ALLOW_CONTRIBUTOR_UPLOAD="false"

# Social/External Content Collector (see docs/SOCIAL_COLLECTOR.md). Encrypts
# `Source.encryptedCredential` (a Facebook Page access token, or a YouTube
# Data API key) at rest — same AES-256-GCM scheme as
# YOUTUBE_TOKEN_ENCRYPTION_KEY above (`src/server/crypto/secretBox.ts`), but
# its own independent key: a leaked Facebook/YouTube collector credential and
# a leaked YouTube upload-channel refresh token are unrelated incidents and
# must not share a blast radius. Never commit a real value; losing it means
# every configured source's credential must be re-entered.
SOURCE_CREDENTIAL_ENCRYPTION_KEY=""
