// Prisma schema — production foundation for Cổng thông tin số Hội Sinh viên
// Việt Nam. See docs/DATABASE_SCHEMA.md for the full ERD and the reasoning
// behind every non-obvious modeling decision referenced in the comments
// below (search that doc for the same all-caps keyword, e.g. "ACTIVITY-STAT
// SHAPE", to find the matching explanation).
//
// Connection URLs live in `prisma.config.ts` (read from `.env`), not here —
// Prisma 7's `datasource` block only declares the provider. See
// docs/ENVIRONMENT.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Enums
// ============================================================

/// Exactly the two states the brief asks for (section 8: "Nếu cần thêm
/// trạng thái phải giải thích") — nothing in this task creates an
/// invite/email-verification flow that would need a third (e.g. PENDING),
/// so none was added speculatively.
enum UserStatus {
  ACTIVE
  DISABLED
}

/// The CMS's three account tiers — brief section 1: "Không tạo thêm cấp
/// quyền khác nếu chưa có yêu cầu mới." `User.role` is a single required
/// field, not a many-to-many join table: exactly one tier per account,
/// matching the brief's own `User` field list (section 8) and its
/// permission tables (one row per role, not a set of roles per user).
/// Extending this to more granular permissions later
/// (`docs/AUTHORIZATION.md`, "Extensibility") means adding a
/// `Permission`/`RolePermission` layer that `AdminRole` maps into — not
/// rewriting this field.
enum AdminRole {
  ADMIN
  MANAGER
  CONTRIBUTOR
}

/// DRAFT -> IN_REVIEW -> APPROVED -> (SCHEDULED ->) PUBLISHED -> ARCHIVED.
/// SCHEDULED and PUBLISHED are kept distinct so "will go live at scheduledAt"
/// and "is live now" are never conflated by a single boolean — see
/// docs/DATABASE_SCHEMA.md, "ARTICLE STATUS".
enum ArticleStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum ArticleBlockType {
  PARAGRAPH
  HEADING
  IMAGE
  GALLERY
  YOUTUBE
  QUOTE
  TABLE
  EMBED
}

/// CENTRAL = Trung ương Hội. PROVINCE/UNIVERSITY/OVERSEAS mirror the three
/// reporting-unit levels the frontend already models
/// (`OrganizationLevel` in `src/domain/people.ts`). OTHER covers anything
/// that doesn't fit those four (a sponsor, a partner body, etc).
enum OrganizationType {
  CENTRAL
  PROVINCE
  UNIVERSITY
  OVERSEAS
  OTHER
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
}

/// MERGED covers a province absorbed into another under an administrative
/// boundary change without deleting its historical row (articles/events tied
/// to it must keep resolving) — see docs/DATABASE_SCHEMA.md, "PROVINCE STATUS".
enum ProvinceStatus {
  ACTIVE
  MERGED
  INACTIVE
}

/// Matches `MediaProvider` in `src/domain/media.ts` one-for-one
/// (`"drive"` -> GOOGLE_DRIVE, `"youtube"` -> YOUTUBE,
/// `"local-placeholder"` -> LOCAL_PLACEHOLDER).
enum MediaProvider {
  GOOGLE_DRIVE
  YOUTUBE
  LOCAL_PLACEHOLDER
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaStatus {
  READY
  MISSING
  REMOVED
  PROCESSING
}

/// What kind of content record a `MediaUsage` row's `referenceId` points
/// into — see that model's comment for why this isn't a typed foreign key.
enum MediaUsageType {
  ARTICLE_COVER
  ARTICLE_OG
  ARTICLE_BLOCK
  GALLERY_ITEM
  EVENT_COVER
  VIDEO_SOURCE
  ORGANIZATION_LOGO
  AUTHOR_AVATAR
  USER_AVATAR
  HOMEPAGE_HERO
}

/// A YOUTUBE-provider `MediaAsset`'s privacy status, mirrored from the
/// video's own YouTube setting (never independently decided by this app) —
/// YouTube integration task, brief section 3. `PRIVATE` is a dead end for
/// this CMS's own purposes: a private video cannot be embedded for an
/// anonymous site visitor at all (only the channel owner / explicitly
/// shared accounts can view it), so it is never selectable for an article's
/// `YoutubeBlock` even though the row itself is kept (e.g. an Admin staging
/// a video before making it public) — see `youtubeService.ts`.
enum YoutubeVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum EventStatus {
  UPCOMING
  LIVE
  COMPLETED
  CANCELLED
}

enum PlatformCategory {
  CONFERENCE
  TRAINING
  SV5TOT
  VOLUNTEER
  DATA
}

enum PlatformStatus {
  LIVE
  ACTIVE
  MAINTENANCE
  OPEN
  UNAVAILABLE
  SOON
}

/// Ecosystem integration task, brief section 3. `SSO_READY` is a
/// classification only — this task does not implement a real SSO handoff,
/// it just records that a platform's real integration is expected to be
/// single-sign-on once built, so the CTA copy/adapter wiring can already
/// branch on it later without another migration. Brief note: "Không iframe
/// mặc định" — none of the three values ever results in embedding the
/// external platform in an `<iframe>`; every one of them is always a real
/// out-link (`<a href>`), just with different CTA semantics.
enum PlatformIntegrationType {
  EXTERNAL_LINK
  API
  SSO_READY
}

/// One entry per homepage section the frontend already renders
/// (`src/app/page.tsx`) — adding a ninth section means adding a ninth value
/// here, not a new table.
enum HomepageSectionKey {
  HERO
  FEATURED_ARTICLES
  STORY_RAIL
  VIDEO_FEATURE
  PLATFORM_CARDS
  EVENTS
  GALLERY
  LOCAL_NEWS
}

/// What a `HomepagePlacement.contentId` points at — same loose-reference
/// pattern as `MediaUsage`/`ActivityStatistic`; see docs/DATABASE_SCHEMA.md.
enum HomepageContentType {
  ARTICLE
  VIDEO
  EVENT
  PLATFORM
  GALLERY
}

/// Generic actions (CREATE/UPDATE/DELETE/PUBLISH/UNPUBLISH/APPROVE) are used
/// by services this task doesn't touch (`EventService`, `MediaService`).
/// User- and Article-workflow actions use the specific values brief section
/// 12 names explicitly instead — a real audit trail should read
/// "CREATE_ARTICLE", not a generic "CREATE" that needs a second lookup
/// against `entityType` to mean anything.
enum AuditAction {
  CREATE
  UPDATE
  DELETE
  PUBLISH
  UNPUBLISH
  APPROVE
  LOGIN
  LOGOUT
  CREATE_USER
  UPDATE_USER
  CHANGE_ROLE
  DISABLE_USER
  ENABLE_USER
  RESET_PASSWORD
  CREATE_ARTICLE
  UPDATE_ARTICLE
  SUBMIT_REVIEW
  APPROVE_ARTICLE
  RETURN_ARTICLE
  PUBLISH_ARTICLE
  UNPUBLISH_ARTICLE
  SCHEDULE_ARTICLE
  /// Non-PUBLISHED -> ARCHIVED (e.g. shelving a stale DRAFT/IN_REVIEW
  /// article) — distinct from UNPUBLISH_ARTICLE (PUBLISHED -> ARCHIVED,
  /// "gỡ bài"), because the CMS brief tracks them as separate actions with
  /// separate UI entry points even though both land on the same status.
  /// See docs/AUTHORIZATION.md, "Article workflow".
  ARCHIVE_ARTICLE
  /// ARCHIVED -> DRAFT, the inverse of ARCHIVE_ARTICLE/UNPUBLISH_ARTICLE.
  /// Not requested by name in either CMS brief, added because a status
  /// transition without any action to trigger or log it would be dead code
  /// (`ALLOWED_TRANSITIONS.ARCHIVED` already permitted DRAFT).
  RESTORE_ARTICLE
  /// Reverting an article's editable fields + blocks to a past
  /// `ArticleRevision` snapshot. Not in either brief's minimum AuditLog
  /// list, added for the same reason as RESTORE_ARTICLE — restoring content
  /// is a real write that needs an audit trail like any other.
  RESTORE_REVISION
  /// Google Drive media task's own audit trio — brief section 11.
  /// `entityType: "MediaAsset"` for all three; `UPDATE_MEDIA`'s metadata
  /// holds which display fields (alt/caption) changed, never the file
  /// itself or any credential.
  UPLOAD_MEDIA
  UPDATE_MEDIA
  DELETE_MEDIA
  /// YouTube integration task's own audit set — brief section 8 names the
  /// first three; `entityType: "MediaAsset"` for those (mirroring
  /// UPLOAD_MEDIA/UPDATE_MEDIA). CONNECT_YOUTUBE/DISCONNECT_YOUTUBE aren't
  /// in the brief's minimum list but were added for the same reason
  /// RESTORE_ARTICLE was: a real credential-adjacent write (an Admin
  /// linking or unlinking the whole channel) with no audit trail otherwise
  /// — `entityType: "YoutubeConnection"` for those two, metadata holding
  /// only the channel id/title, never the token.
  UPLOAD_VIDEO
  LINK_VIDEO
  UPDATE_VIDEO
  CONNECT_YOUTUBE
  DISCONNECT_YOUTUBE
  /// Ecosystem integration task, brief section 8. Generic `CREATE`/`DELETE`
  /// (already in this enum) cover creating/removing a `Platform` row
  /// itself — these three are for the transitions the brief calls out by
  /// name: any content/config change (`UPDATE_PLATFORM`, covers both the
  /// display-field group and, for an Admin, the integration-field group —
  /// `metadata` records which), and the `isEnabled` toggle specifically
  /// (`ENABLE_PLATFORM`/`DISABLE_PLATFORM`), kept distinct from a generic
  /// update because "a platform went dark on the public site" is a
  /// different kind of event to an auditor than "someone edited its
  /// description".
  UPDATE_PLATFORM
  ENABLE_PLATFORM
  DISABLE_PLATFORM
}

/// Editorial workflow task, brief section 9: the exact 4 events that must
/// notify someone. Not a generic "activity feed" type list — each value
/// maps to exactly one trigger point in `articleService.ts` and one
/// Vietnamese message template in `notificationService.ts`.
enum NotificationType {
  ARTICLE_SUBMITTED
  ARTICLE_RETURNED
  ARTICLE_APPROVED
  ARTICLE_PUBLISHED
}

// ============================================================
// Identity & access
// ============================================================

/// A system account (can log in to `/admin`). Distinct from `AuthorProfile`
/// — a byline ("who wrote this") is not always a person with a login, and a
/// person with a login is not always credited as a byline. See
/// `AuthorProfile` below.
///
/// `role` is a single required `AdminRole`, not a many-to-many join table
/// (the earlier, more generic `Role`/`UserRole` tables from the backend-
/// foundation task were replaced by this — see docs/AUTHORIZATION.md,
/// "Why a single `role` field, not a join table" for why keeping both
/// would have meant two competing "what can this user do" answers in the
/// same schema).
model User {
  id            String     @id @default(cuid())
  email         String     @unique
  username      String?    @unique
  passwordHash  String
  displayName   String
  avatarMediaId String?
  role          AdminRole  @default(CONTRIBUTOR)
  status        UserStatus @default(ACTIVE)
  lastLoginAt   DateTime?
  createdById   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  avatarMedia   MediaAsset?    @relation("UserAvatar", fields: [avatarMediaId], references: [id])
  createdBy     User?          @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers  User[]         @relation("UserCreatedBy")
  authorProfile AuthorProfile?
  sessions      Session[]

  createdArticles            Article[]               @relation("ArticleCreatedBy")
  updatedArticles            Article[]               @relation("ArticleUpdatedBy")
  articleRevisions           ArticleRevision[]
  articleNotes               ArticleNote[]
  uploadedMedia              MediaAsset[]            @relation("MediaCreatedBy")
  auditLogs                  AuditLog[]
  homepageConfigurationEdits HomepageConfiguration[]
  youtubeConnections         YoutubeConnection[]
  notifications              Notification[]

  @@index([role])
}

/// A server-side login session (`docs/AUTHENTICATION.md`, "Session"). The
/// browser only ever holds `id` (an opaque random token, HttpOnly cookie);
/// `tokenHash` stores a SHA-256 hash of that token, never the token itself
/// — a database leak alone can't be replayed as a valid session, the same
/// reasoning as storing a password hash instead of the password. Every
/// admin request re-validates against this table (`expiresAt` and the
/// owning `User.status`), never trusting the cookie's mere presence.
model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  ipAddress  String?
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// The public byline identity a reader sees on an article — matches
/// `Author` in `src/domain/people.ts` (id/name/title/avatar). `userId` is
/// nullable on purpose: many bylines in a student-press context are
/// contributors who submit copy without ever getting a CMS login.
model AuthorProfile {
  id            String   @id @default(cuid())
  userId        String?  @unique
  displayName   String
  title         String?
  avatarMediaId String?
  bio           String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User?       @relation(fields: [userId], references: [id])
  avatarMedia MediaAsset? @relation("AuthorAvatar", fields: [avatarMediaId], references: [id])
  articles    Article[]
}

// ============================================================
// Taxonomy (section 6 — three distinct tables on purpose)
// ============================================================

/// Primary classification — exactly one per article (enforced by
/// `Article.categoryId` being required, not a join table). Also doubles as
/// the Activity Map's category filter dimension (`ActivityStatistic.categoryId`)
/// — the fixture's map filter chips ("Tình nguyện", "Nghiên cứu khoa học", ...)
/// are literally the same Vietnamese labels as the article categories, so
/// this is one table serving both, not a coincidence to re-model separately.
model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  articles           Article[]
  videos             Video[]
  activityStatistics ActivityStatistic[]
}

/// A curated editorial theme with its own landing page (e.g. "Đại hội XII").
/// Many-to-many with Article — one topic page pulls from several articles,
/// and (per `docs/LISTING_PAGES.md`) an article can genuinely belong to more
/// than one topic.
model Topic {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String?
  coverMediaId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  coverMedia MediaAsset?    @relation("TopicCover", fields: [coverMediaId], references: [id])
  articles   ArticleTopic[]
}

model ArticleTopic {
  articleId String
  topicId   String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  topic   Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([articleId, topicId])
}

/// Freeform keyword, many per article, no landing page — kept as its own
/// table (not folded into Category/Topic) because it has neither Category's
/// "exactly one, drives the primary URL" role nor Topic's "has a landing
/// page" role. See brief section 6: "Không nhập Category/Topic/Tag thành
/// cùng một bảng nếu chức năng thực tế khác nhau."
model Tag {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  articles ArticleTag[]
}

model ArticleTag {
  articleId String
  tagId     String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

// ============================================================
// Geography & organizations (sections 7-8)
// ============================================================

/// One of Vietnam's provinces/centrally-run cities. `mapCode` is the
/// 2-digit code the Activity Map's topojson/fixture keys off
/// (`ActivityMapProvince.province_id`, e.g. "01" for Hà Nội) — kept distinct
/// from `code` (a longer-form official administrative code) because the two
/// numbering schemes are not guaranteed to be the same value, only the same
/// province.
model Province {
  id        String         @id @default(cuid())
  code      String         @unique
  mapCode   String         @unique
  slug      String         @unique
  name      String
  lat       Float
  lon       Float
  status    ProvinceStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  organizations      Organization[]
  articles           Article[]
  events             Event[]
  activityStatistics ActivityStatistic[]
}

/// The Activity Map's overseas globe panel — one row per country chapter
/// (Hội Sinh viên Việt Nam tại Australia, tại Pháp, ...). `activityCount` is
/// a deliberately denormalized running total, not a `province`-style
/// per-period/per-category `ActivityStatistic` history: the current
/// UI/fixture only ever needs one number per country (no category
/// breakdown, no history), so a mirrored statistics table would be built
/// speculatively. See docs/DATABASE_SCHEMA.md, "OVERSEAS ACTIVITY — SCOPE".
model OverseasOrganization {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String   @unique
  countryCode    String?
  activityCount  Int      @default(0)
  organizationId String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
}

/// Trung ương Hội, Hội Sinh viên tỉnh/thành, Hội Sinh viên trường, Hội Sinh
/// viên Việt Nam ở nước ngoài, hoặc đơn vị khác. `parentId` gives the
/// hierarchy the brief asks for (a university chapter reports up to its
/// province chapter, which reports up to Trung ương) without a separate
/// hierarchy table.
model Organization {
  id          String             @id @default(cuid())
  name        String
  shortName   String?
  slug        String             @unique
  type        OrganizationType
  logoMediaId String?
  provinceId  String?
  countryCode String?
  website     String?
  facebook    String?
  youtube     String?
  status      OrganizationStatus @default(ACTIVE)
  parentId    String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  parent    Organization?  @relation("OrganizationHierarchy", fields: [parentId], references: [id])
  children  Organization[] @relation("OrganizationHierarchy")
  province  Province?      @relation(fields: [provinceId], references: [id])
  logoMedia MediaAsset?    @relation("OrganizationLogo", fields: [logoMediaId], references: [id])

  articles             Article[]
  events               Event[]
  overseasOrganization OverseasOrganization?
}

// ============================================================
// Media metadata (section 10 — no binary storage)
// ============================================================

/// Metadata only — the actual file lives with its provider (Google Drive,
/// YouTube) or, for LOCAL_PLACEHOLDER, doesn't exist at all yet. Binary
/// upload/storage handling is explicitly out of scope for this task (brief
/// item 18) — this table exists so every other model has something to point
/// a `*MediaId` foreign key at today, ready for a real upload pipeline later
/// without a schema change.
model MediaAsset {
  id             String        @id @default(cuid())
  provider       MediaProvider
  providerFileId String?
  type           MediaType
  mimeType       String?
  filename       String?
  width          Int?
  height         Int?
  size           Int?
  alt            String?
  caption        String?
  status         MediaStatus   @default(MISSING)
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  /// YouTube integration task (brief sections 3-4) — meaningful only for
  /// `provider: YOUTUBE`. `visibility` mirrors the video's real YouTube
  /// privacy status (never independently decided here); `durationSeconds`
  /// and `errorReason` are populated from YouTube Data API responses at
  /// upload/link time and refreshed on demand (`/admin/media/videos`'s
  /// "Kiểm tra trạng thái"), not on every page view. `filename` doubles as
  /// the video's own YouTube title and `caption` as its description for a
  /// YOUTUBE asset — reusing the existing display fields rather than adding
  /// two near-duplicate columns.
  visibility      YoutubeVisibility?
  durationSeconds Int?
  /// A short machine-readable code (`"private"`, `"embed_disabled"`,
  /// `"removed"`, `"quota_exceeded"`, `"upload_failed"`, `"processing"`) set
  /// whenever a status check finds the video isn't currently playable —
  /// brief section 7's error states. Cleared once a refresh finds it
  /// healthy again. Deliberately a free-form string, not a DB enum: the set
  /// of reasons is defined and validated in `youtubeService.ts`, not the
  /// schema, so a new one never needs a migration.
  errorReason     String?

  createdBy User? @relation("MediaCreatedBy", fields: [createdById], references: [id])

  usages MediaUsage[]

  usedAsUserAvatar   User[]          @relation("UserAvatar")
  usedAsAuthorAvatar AuthorProfile[] @relation("AuthorAvatar")
  usedAsOrgLogo      Organization[]  @relation("OrganizationLogo")
  usedAsTopicCover   Topic[]         @relation("TopicCover")
  usedAsArticleCover Article[]       @relation("ArticleCover")
  usedAsArticleOg    Article[]       @relation("ArticleOg")
  usedAsEventCover   Event[]         @relation("EventCover")
  usedAsPlatformIcon Platform[]      @relation("PlatformIcon")
  galleryItems       GalleryItem[]
  videos             Video[]

  @@index([provider, providerFileId])
}

/// Explicit "where is this asset actually used" index, separate from the
/// direct `*MediaId` foreign keys above. Those FKs answer "what does this
/// article's cover point to"; this table answers the reverse question — "if
/// I delete/replace this asset, what breaks" — across every content type in
/// one place, including uses a typed FK can't reach (e.g. one image
/// referenced from inside an `ArticleBlock.data` JSON gallery block).
/// `referenceId` is intentionally untyped (see `HomepagePlacement.contentId`
/// for the same pattern) since it can point at rows in several different
/// tables depending on `usageType`.
model MediaUsage {
  id          String         @id @default(cuid())
  mediaId     String
  usageType   MediaUsageType
  referenceId String
  createdAt   DateTime       @default(now())

  media MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([usageType, referenceId])
  @@index([mediaId])
}

/// The single OAuth link between this app and one YouTube channel — YouTube
/// integration task, brief section 9: "OAuth token server-side." At most
/// one row is ever meant to exist (`id: "default"`, a fixed singleton key
/// `youtubeConnectionRepository.ts` always upserts/reads by, the same
/// pattern a one-row settings table would use) — a second row is never
/// created; reconnecting replaces this one. `encryptedRefreshToken` is
/// AES-256-GCM-encrypted with `YOUTUBE_TOKEN_ENCRYPTION_KEY`
/// (`src/server/integrations/youtube.ts`) — even a raw database dump never
/// hands out a usable token, mirroring the "hash, don't store plaintext"
/// discipline `User.passwordHash` already uses elsewhere (the difference
/// being this value must be decryptable, since the API call itself needs
/// the real token, unlike a one-way password hash). No service or route
/// ever returns the decrypted value to a client — only connection status
/// (channel title, connected-by, connected-at) is ever exposed, per brief
/// section 9: "CONTRIBUTOR không được đọc token" (in practice, no role's
/// client-facing response ever includes it, not just Contributor's).
model YoutubeConnection {
  id                    String   @id @default("default")
  channelId             String
  channelTitle          String
  encryptedRefreshToken String
  scope                 String
  connectedById         String
  connectedAt           DateTime @default(now())
  updatedAt             DateTime @updatedAt

  connectedBy User @relation(fields: [connectedById], references: [id])
}

model Gallery {
  id          String   @id @default(cuid())
  slug        String?  @unique
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items GalleryItem[]
}

model GalleryItem {
  id        String  @id @default(cuid())
  galleryId String
  mediaId   String
  order     Int
  caption   String?

  gallery Gallery    @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  media   MediaAsset @relation(fields: [mediaId], references: [id])

  @@unique([galleryId, order])
}

/// The homepage's standalone video/reportage feature — distinct from an
/// article's inline `YoutubeBlock` (`ArticleBlock` with type YOUTUBE): this
/// is its own playlist-style entity with a title/description/category of
/// its own, not scoped to one article's body.
model Video {
  id              String    @id @default(cuid())
  slug            String?   @unique
  title           String
  description     String
  categoryId      String
  durationSeconds Int?
  mediaId         String
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  category Category   @relation(fields: [categoryId], references: [id])
  media    MediaAsset @relation(fields: [mediaId], references: [id])
}

// ============================================================
// Article (sections 3-5)
// ============================================================

model Article {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  subtitle       String?
  excerpt        String?
  status         ArticleStatus @default(DRAFT)
  coverMediaId   String?
  categoryId     String
  authorId       String?
  organizationId String?
  provinceId     String?
  publishedAt    DateTime?
  scheduledAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  createdById    String?
  updatedById    String?
  /// Set when a Manager/Admin returns the article to its Contributor for
  /// revision (brief section 9's REVIEW -> RETURN step); cleared the next
  /// time it's submitted for review. Kept as a live field, not just buried
  /// in `ArticleRevision.note` history, because the Contributor's own edit
  /// view needs to surface it directly. See docs/AUTHORIZATION.md, "Article
  /// workflow".
  returnNote     String?

  // SEO
  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  ogMediaId      String?

  category     Category       @relation(fields: [categoryId], references: [id])
  author       AuthorProfile? @relation(fields: [authorId], references: [id])
  organization Organization?  @relation(fields: [organizationId], references: [id])
  province     Province?      @relation(fields: [provinceId], references: [id])
  coverMedia   MediaAsset?    @relation("ArticleCover", fields: [coverMediaId], references: [id])
  ogMedia      MediaAsset?    @relation("ArticleOg", fields: [ogMediaId], references: [id])
  createdBy    User?          @relation("ArticleCreatedBy", fields: [createdById], references: [id])
  updatedBy    User?          @relation("ArticleUpdatedBy", fields: [updatedById], references: [id])

  blocks      ArticleBlock[]
  revisions   ArticleRevision[]
  topics      ArticleTopic[]
  tags        ArticleTag[]
  slugHistory ArticleSlugHistory[]
  notes       ArticleNote[]

  activityStatisticsAsLatest ActivityStatistic[] @relation("ActivityStatisticLatestArticle")

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([provinceId])
  @@index([organizationId])
}

/// A slug this Article used to have while it was (or had ever been)
/// PUBLISHED — CMS brief section 12: "Nếu bài đã public và slug thay đổi:
/// thiết kế redirect history." Only written when the article being renamed
/// has a non-null `publishedAt` (a DRAFT that never went live has no public
/// URL anyone could have bookmarked or indexed, so renaming it needs no
/// history). The public `/tin-tuc/[slug]` route checks this table when a
/// slug lookup misses, so an old bookmarked/indexed URL 301s to the
/// article's current slug instead of 404ing.
model ArticleSlugHistory {
  id        String   @id @default(cuid())
  articleId String
  slug      String   @unique
  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

/// One row per content block, ordered within its article. `data` is a
/// per-`type` JSON payload shaped exactly like the matching frontend variant
/// in `src/domain/articleContent.ts` (`ParagraphBlock`, `ImageBlock`, ...) —
/// see docs/BACKEND_ARCHITECTURE.md, "Article block validation" for where
/// that per-type shape is actually enforced (the application/service layer,
/// via a discriminated Zod schema — Postgres `jsonb` has no per-row schema
/// of its own).
model ArticleBlock {
  id        String           @id @default(cuid())
  articleId String
  type      ArticleBlockType
  order     Int
  data      Json

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, order])
}

/// A full snapshot of an article's editable fields + blocks at one point in
/// time, taken on every production edit. `version` is a simple
/// per-article incrementing counter (1, 2, 3, ...), not a global sequence.
/// No revision-restore/diff UI is built in this task (brief section 5: "Không
/// cần làm UI revision") — this table only has to exist and be written to.
model ArticleRevision {
  id          String   @id @default(cuid())
  articleId   String
  version     Int
  snapshot    Json
  changedById String?
  note        String?
  createdAt   DateTime @default(now())

  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  changedBy User?   @relation(fields: [changedById], references: [id])

  @@unique([articleId, version])
}

/// Editorial workflow task, brief section 8: "Cho phép ghi chú nội bộ.
/// Không public." Distinct from `Article.returnNote` — that field is the
/// one mandatory note attached to a single Return action and gets cleared
/// on the next resubmit; this is a free-form, append-only discussion
/// thread (a Manager flagging something for a Contributor mid-review, a
/// Contributor explaining a source, ...) that persists across the whole
/// life of the article regardless of how many times it's returned. Never
/// rendered by any public route — only `/admin/articles/[id]/edit`. Anyone
/// who can view the article (`articleService.canView`) can read and add to
/// it, matching the same visibility rule as the article itself rather than
/// introducing a fourth permission tier.
model ArticleNote {
  id        String   @id @default(cuid())
  articleId String
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author  User?   @relation(fields: [authorId], references: [id])

  @@index([articleId, createdAt])
}

/// Editorial workflow task, brief section 9/10: in-app notifications only
/// (no email/push) — `entityType`/`entityId` is the same loose-reference
/// pattern as `AuditLog`/`MediaUsage`, since every current `NotificationType`
/// points at an `Article` but a future type might not. `message` is a
/// fully-rendered Vietnamese string decided once at write time by
/// `notificationService`, not re-derived from `type` at read time — so
/// changing a message template later never rewrites history.
model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType
  entityType String
  entityId   String
  message    String
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

// ============================================================
// Events (section 9)
// ============================================================

model Event {
  id               String      @id @default(cuid())
  slug             String      @unique
  title            String
  summary          String?
  coverMediaId     String?
  startAt          DateTime
  endAt            DateTime
  location         String?
  provinceId       String?
  organizationId   String
  status           EventStatus @default(UPCOMING)
  externalUrl      String?
  participantCount Int?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  province     Province?    @relation(fields: [provinceId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  coverMedia   MediaAsset?  @relation("EventCover", fields: [coverMediaId], references: [id])

  @@index([status, startAt])
  @@index([provinceId])
}

// ============================================================
// Platforms (ecosystem integration task)
// ============================================================

/// The registry entry for one external ecosystem platform (Hội nghị, Đào
/// tạo, Sinh viên 5 tốt, Tình nguyện, ...+ any added later — brief header:
/// "các platform khác sau này"). Two field groups, split by who may edit
/// them (`src/server/services/platformService.ts`, `permissions.ts`'s
/// `platform.manage` vs `platform.manage.display`):
///
///  - "Tích hợp kỹ thuật" (ADMIN only — brief section 1 "toàn quyền"):
///    `category`, `integrationType`, `apiBaseUrl`.
///  - "Nội dung/hiển thị" (ADMIN + MANAGER — brief section 1 "quản lý nội
///    dung/hiển thị"): everything else, including `isEnabled`/`status`
///    ("display state", brief section 7) and `currentActivity` (either
///    hand-written by an editor or overwritten by an adapter refresh —
///    see `platformService.refreshActivity`).
///
/// `apiBaseUrl` is never read by any public route — only
/// `platformService.refreshActivity` (an authenticated Admin/Manager
/// action) ever calls out to it, through the matching adapter in
/// `src/server/integrations/platformAdapters/`. The public homepage always
/// renders `currentActivity`/`status` as already stored here — see
/// docs/ECOSYSTEM_INTEGRATION.md, "Failure isolation" for why the public
/// path never blocks on an external platform's own uptime.
model Platform {
  id          String                  @id @default(cuid())
  slug        String                  @unique
  name        String
  url         String
  description String
  category    PlatformCategory
  status      PlatformStatus
  accessLevel String
  metric      String?
  /// What's happening right now, shown on the homepage bento card (e.g.
  /// "Phiên biểu quyết đang mở", "14 khoá đang mở"). Renamed from
  /// `liveActivityNote` — same field, now also writable by
  /// `platformService.refreshActivity()` for an `integrationType: API`
  /// platform, not just by hand.
  currentActivity          String?
  /// Set only by `refreshActivity()` — when this is non-null but old, the
  /// admin UI can show "dữ liệu lúc HH:mm, làm mới thất bại" instead of
  /// silently presenting a stale value as fresh. `null` for a platform
  /// whose `currentActivity` (if any) was hand-typed and never refreshed.
  currentActivityUpdatedAt DateTime?
  /// Overrides the per-category default CTA copy `buildPlatformView`
  /// (`src/lib/view/platformView.ts`) would otherwise use — `null` keeps
  /// that default, so existing content needs no migration backfill.
  ctaLabel    String?
  iconMediaId String?
  /// See `PlatformIntegrationType`'s own comment. Never changes what the
  /// public CTA renders as (always a real link, brief section 3: "Không
  /// iframe mặc định") — only which adapter (if any) `refreshActivity` is
  /// allowed to call.
  integrationType PlatformIntegrationType @default(EXTERNAL_LINK)
  /// The base URL `src/server/integrations/platformAdapters/*` calls for
  /// this platform's live activity — meaningless (and ignored) unless
  /// `integrationType: API`. Never exposed to any public route.
  apiBaseUrl  String?
  /// Homepage bento position among platforms sharing a render slot, and
  /// the admin listing's default sort — ascending, lower first.
  order       Int                     @default(0)
  /// Hard on/off switch, independent of `status` (brief section 7: "quản
  /// lý display state") — a disabled platform never appears on the public
  /// homepage regardless of `status`, e.g. to unpublish a platform being
  /// decommissioned without deleting its registry row (audit trail,
  /// `HomepagePlacement` references) along with it. See
  /// `AuditAction.ENABLE_PLATFORM`/`DISABLE_PLATFORM` — this specific
  /// toggle gets its own audit action, not folded into generic
  /// `UPDATE_PLATFORM`.
  isEnabled   Boolean                 @default(true)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  iconMedia MediaAsset? @relation("PlatformIcon", fields: [iconMediaId], references: [id])

  @@index([category])
  @@index([isEnabled, order])
}

// ============================================================
// Activity Map statistics (section 8)
// ============================================================

/// One row per (province, category, period). `categoryId = null` is the
/// "all categories" aggregate row for that province+period — the same
/// numbers the fixture stores at the top level of a province entry
/// (`activity_count`, `article_count`, ...); a row *with* `categoryId` set
/// is one entry of that same fixture's `category_distribution` map. This
/// lets one table serve both shapes the frontend already reads, matching
/// the brief's literal field list (`categoryId optional`) instead of a
/// separate breakdown table. See docs/DATABASE_SCHEMA.md, "ACTIVITY-STAT
/// SHAPE".
///
/// `latestArticleId` replaces the fixture's denormalized
/// `{ title, published_at }` snapshot with a real foreign key — a join
/// against `Article` can never drift from the article it names, which a
/// hand-copied title/date pair could.
model ActivityStatistic {
  id                String   @id @default(cuid())
  provinceId        String
  categoryId        String?
  period            String
  activityCount     Int?
  articleCount      Int?
  organizationCount Int?
  participantCount  Int?
  latestArticleId   String?
  reported          Boolean  @default(true)
  updatedAt         DateTime @updatedAt

  province      Province  @relation(fields: [provinceId], references: [id])
  category      Category? @relation(fields: [categoryId], references: [id])
  latestArticle Article?  @relation("ActivityStatisticLatestArticle", fields: [latestArticleId], references: [id])

  @@unique([provinceId, categoryId, period])
  @@index([period])
}

// ============================================================
// Homepage configuration (section 11)
// ============================================================

/// A named, versionable set of homepage section settings. `isActive` marks
/// which one the public site currently reads — exactly one row should carry
/// `isActive: true`, enforced at the service layer (`HomepageService`), not
/// by a DB constraint, so a future "preview a draft configuration" admin
/// feature can keep multiple inactive rows around without fighting a
/// uniqueness rule.
model HomepageConfiguration {
  id          String   @id @default(cuid())
  name        String   @default("default")
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  updatedById String?

  updatedBy User?             @relation(fields: [updatedById], references: [id])
  sections  HomepageSection[]
}

/// One configured slot (Hero, FeaturedArticles, ...) within a configuration.
/// Deleting/disabling every `HomepagePlacement` under a section does not
/// remove the section itself — see `HomepagePlacement` for the fallback
/// this is designed around.
model HomepageSection {
  id              String             @id @default(cuid())
  configurationId String
  key             HomepageSectionKey
  order           Int
  isEnabled       Boolean            @default(true)

  configuration HomepageConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  placements    HomepagePlacement[]

  @@unique([configurationId, key])
}

/// One curated piece of content inside a section (e.g. "this Article is the
/// Hero" or "these five Articles are Featured, in this order"). `contentId`
/// is untyped like `MediaUsage.referenceId` — what table it points into
/// depends on `contentType`.
///
/// Brief requirement: "phải giữ fallback tự động nếu CMS chưa cấu hình" — a
/// section with zero enabled/currently-active placements is not an error
/// state the schema needs to represent; `HomepageService` (see
/// docs/BACKEND_ARCHITECTURE.md) falls back to an automatic query (e.g.
/// "most recent published Article") whenever a section resolves no
/// placements, so the homepage is never empty just because nobody has
/// configured it yet.
model HomepagePlacement {
  id          String              @id @default(cuid())
  sectionId   String
  contentType HomepageContentType
  contentId   String
  order       Int
  activeFrom  DateTime?
  activeUntil DateTime?
  isEnabled   Boolean             @default(true)

  section HomepageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId, order])
  @@index([contentType, contentId])
}

// ============================================================
// Audit log (section 12)
// ============================================================

/// One row per important write. `entityType`/`entityId` is the same
/// loose-reference pattern as `MediaUsage`/`HomepagePlacement` — an audit
/// log has to be able to point at literally any table, so a typed FK per
/// entity type isn't practical. `metadata` holds action-specific extras
/// (e.g. which fields changed) as JSON rather than a rigid column set.
model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  action     AuditAction
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime    @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}
