# Copy to `.env` and fill in real values. Consumed by docker-compose.yml.
# Generate each secret with the command shown.

# openssl rand -hex 24
POSTGRES_PASSWORD=

# openssl rand -hex 32  (two DIFFERENT random values, never reused)
SOURCE_CREDENTIAL_ENCRYPTION_KEY=
YOUTUBE_TOKEN_ENCRYPTION_KEY=

# Shared identity service (/opt/hsv-id). Must equal INTERNAL_API_KEY in
# /opt/hsv-id/.env — the same value hoinghi and daotaohsv use.
HSV_ID_INTERNAL_KEY=
